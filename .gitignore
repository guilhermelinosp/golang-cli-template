# OS
.DS_Store
Thumbs.db

# Neutralize user-global ignores (~/.config/git/ignore) that would
# otherwise swallow template paths: 'build/' and '.github/'. Project rules
# outrank the global file, keeping these tracked for every derived repo.
!internal/build/
!.github/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Build
bin/
dist/
out/
*.exe
*.dll
*.so
*.dylib

# Dependencies
vendor/

# Secrets
*.key
*.pem
.env
.env.local

# Logs
*.log

# Test
coverage.out
coverage.html

# Compiled binary at repo root (derived projects' default name)
/app
/app.exe
